{
  "name": "dsh-antv-ava-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./service": {
      "types": "./lib/service.d.ts",
      "default": "./lib/service.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@antv/ava": "4.0.0-beta.2",
    "dsh-antv-ava": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.8 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.8 || 0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.8",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.2",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "description": "Optional AVA v4 file analysis tools for dsh-antv-ava: session-scoped uploads, DuckDB queries and durable results.",
  "license": "MIT",
  "author": "HellowVirgil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HellowVirgil/dsh-antv-ava.git",
    "directory": "runtime"
  }
}
